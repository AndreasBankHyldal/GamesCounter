{
  "name": "games-counter-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run build --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:server": "npm run build --workspace apps/server",
    "start:server": "npm run start --workspace apps/server",
    "lint": "npm run lint --workspace apps/web",
    "typecheck:games": "tsc -p packages/games"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
