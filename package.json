{
  "name": "games-counter-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run build --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:server": "npm run build --workspace apps/server",
    "start:server": "npm run start --workspace apps/server",
    "render:status": "node scripts/render-admin.mjs status",
    "render:sleep": "node scripts/render-admin.mjs sleep",
    "lint": "npm run lint --workspace apps/web",
    "typecheck:games": "tsc -p packages/games"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "@koa/cors": "5.0.0",
    "koa-socket-2": {
      "socket.io": "4.8.3"
    },
    "engine.io@^6": "6.6.10",
    "socket.io-parser@^4": "4.2.7",
    "ws@^8": "8.21.0",
    "qs": "6.16.0",
    "nanoid@^3": "3.3.20",
    "react-cookies": {
      "cookie": "0.7.2"
    },
    "shell-quote": "1.11.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2",
    "zod": "4.6.6",
    "esbuild": "0.28.1"
  }
}
